{
  "rubric_paths": [
    "~/.review-bus/rubrics"
  ],
  "rubric_packs": [],
  "storage": {
    "documents": "~/.review-bus/reviews"
  },
  "default_reviewers": [
    "codex",
    "claude"
  ],
  "author_vendors": {
    "claude-code": "anthropic",
    "codex-mcp-client": "openai"
  },
  "allowed_reviewers": {
    "contract-b2b": [
      "codex",
      "claude"
    ]
  },
  "merge_with": {
    "adapter": "claude",
    "model": "haiku",
    "effort": "low"
  },
  "max_wait_seconds": 50,
  "snapshot_wait_seconds": 10,
  "http": {
    "host": "127.0.0.1",
    "port": 7777,
    "token_file": "~/.review-bus/http-token",
    "allow_remote": false,
    "allowed_hosts": []
  },
  "adapters": {
    "codex": {
      "type": "codex",
      "command": "codex",
      "vendor": "openai",
      "model": null,
      "effort": "medium",
      "args": [],
      "timeout_seconds": 900
    },
    "claude": {
      "type": "claude",
      "command": "claude",
      "vendor": "anthropic",
      "model": null,
      "effort": "medium",
      "args": [],
      "timeout_seconds": 900
    },
    "agy": {
      "type": "agy",
      "command": "agy",
      "vendor": "google",
      "model": null,
      "effort": "medium",
      "args": [],
      "timeout_seconds": 600
    },
    "codex-native": {
      "type": "codex-review",
      "command": "codex",
      "vendor": "openai",
      "model": null,
      "effort": "medium",
      "args": [],
      "timeout_seconds": 900
    },
    "person": {
      "type": "pull",
      "vendor": "other",
      "timeout_seconds": 172800,
      "claim_clients": []
    }
  },
  "policy": {
    "max_blocking": 5,
    "max_rounds": 3
  }
}
