{
  "name": "review-bus",
  "version": "0.2.0",
  "description": "Cross-agent review: an agent submits work (documents, code changes, web pages), other agents or people review it, and the author must answer every blocking finding. MCP server, rb CLI and web inbox.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-review",
    "document-review",
    "ai-agents",
    "claude",
    "codex",
    "review"
  ],
  "author": "Insightful3",
  "homepage": "https://github.com/Insightful3/review-bus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Insightful3/review-bus.git"
  },
  "bugs": {
    "url": "https://github.com/Insightful3/review-bus/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "review-bus": "dist/src/server.js",
    "rb": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "rubrics",
    "spec",
    "review-bus.config.example.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p . && node dist/src/spec/gen-schema.js",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "start": "node dist/src/server.js",
    "check:isolation": "npm run build && node scripts/check-isolation.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "mammoth": "^1.13.0",
    "playwright-core": "^1.65.0",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.6",
    "docx": "^9.15.3",
    "pdf-lib": "^1.17.1",
    "typescript": "^7.0.2"
  }
}
