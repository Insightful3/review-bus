{
  "name": "review-bus",
  "version": "0.1.0",
  "description": "Cross-agent review layer: agents submit work, other agents or people review it, the verdict comes back as structured state.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "review-bus": "dist/src/server.js"
  },
  "scripts": {
    "build": "tsc -p . && node dist/src/spec/gen-schema.js",
    "test": "npm run build && node --test dist/test/",
    "start": "node dist/src/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "mammoth": "^1.13.0",
    "playwright-core": "^1.65.0",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.6",
    "docx": "^9.15.3",
    "pdf-lib": "^1.17.1",
    "typescript": "^7.0.2"
  }
}
